#!/usr/bin/env bash
# pre-push git hook — enterprise counterpart of hooks/push-guard.sh (ruling E1, goal
# opus5-enterprise, 2026-07-25): applies the SAME `.harness/push-policy` at the git
# layer, so it survives managed settings and also covers human pushes. Identical policy
# format: "<remote-glob> <ref-glob> [force-ok]"; no file ⇒ allow (opt-in per project).
# Non-fast-forward and delete count as force (they require force-ok).
# Per-repo install: tools/install-git-guards.sh (never automatic from install.sh).
# git invokes: pre-push <remote-name> <url>, lines on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>

exec python3 - "$1" 3<&0 <<'PY'
import fnmatch, os, subprocess, sys

remote = sys.argv[1] if len(sys.argv) > 1 else "origin"

def git(*args):
    try:
        r = subprocess.run(["git", *args], capture_output=True, text=True, timeout=10)
        return r.returncode, r.stdout.strip()
    except Exception:
        return 1, ""

rc, root = git("rev-parse", "--show-toplevel")
if rc != 0 or not root:
    sys.exit(0)
policy = os.path.join(root, ".harness", "push-policy")
if not os.path.isfile(policy):
    sys.exit(0)  # the project hasn't opted in

rules = []
for ln in open(policy, encoding="utf-8", errors="replace"):
    ln = ln.split("#", 1)[0].strip()
    if not ln:
        continue
    toks = ln.split()
    rules.append({"remote": toks[0],
                  "ref": toks[1] if len(toks) > 1 else "*",
                  "force_ok": "force-ok" in toks[2:] or (len(toks) > 1 and toks[1] == "force-ok")})

ZERO = "0" * 40

def allowed(ref, forced):
    for r in rules:
        if fnmatch.fnmatch(remote, r["remote"]) and (fnmatch.fnmatch(ref, r["ref"]) or r["ref"] == "*"):
            if forced and not r["force_ok"]:
                continue
            return True
    return False

for line in open(3):
    parts = line.split()
    if len(parts) != 4:
        continue
    _local_ref, local_sha, remote_ref, remote_sha = parts
    ref = remote_ref
    for p in ("refs/heads/", "refs/tags/"):
        if ref.startswith(p):
            ref = ref[len(p):]
    deletion = local_sha == ZERO
    rewrite = False
    if not deletion and remote_sha != ZERO:
        rc, _ = git("merge-base", "--is-ancestor", remote_sha, local_sha)
        rewrite = rc != 0  # the remote is not an ancestor of the local ⇒ non-fast-forward
    if not allowed(ref, deletion or rewrite):
        print(f"pre-push guard: '{remote} {ref}'"
              + (" (force/delete)" if (deletion or rewrite) else "")
              + f" is outside {os.path.relpath(policy, root)} — docket it, don't push.", file=sys.stderr)
        sys.exit(1)
sys.exit(0)
PY
