#!/usr/bin/env bash
# commit-msg git hook — enterprise counterpart of hooks/strip-ai-attribution.sh (ruling
# E1, goal opus5-enterprise, 2026-07-25): managed settings can switch off Claude Code
# hooks, git hooks they cannot — and this also covers commits made by hand. Rewrites the
# message file ($1) removing AI attribution lines; never blocking.
# Per-repo install: tools/install-git-guards.sh (never automatic from install.sh).

exec python3 - "$1" <<'PY'
import re, sys

path = sys.argv[1]
text = open(path, encoding="utf-8", errors="replace").read()
ATTRIB = re.compile(
    r"(?m)^[ \t]*("
    r"\U0001F916?[ \t]*Generated with \[?Claude[^\n]*"
    r"|Co-Authored-By:[^\n]*(?:[Cc]laude|[Aa]nthropic)[^\n]*"
    r"|Claude-Session:[^\n]*"
    r")\n?"
)
new = ATTRIB.sub("", text)
if new != text:
    open(path, "w", encoding="utf-8").write(new)
    print("strip-ai-attribution (git commit-msg): removed AI attribution lines.", file=sys.stderr)
PY
